# Database
DATABASE_URL="postgresql://schoolmart:schoolmart_dev@localhost:5432/schoolmart?schema=public"

# API
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development
# On Railway/Render, PORT is set automatically (API reads PORT then API_PORT)

# Auth
JWT_SECRET="change-me-in-production-use-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
COOKIE_SECRET="change-me-cookie-secret"

# Web
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
# Public support line on /contact (hidden when unset), e.g. "+254 712 345 678"
NEXT_PUBLIC_CONTACT_PHONE=""
WEB_URL="http://localhost:3000"
# Production example:
# NEXT_PUBLIC_API_URL="https://your-api.up.railway.app/api/v1"
# WEB_URL="https://your-app.vercel.app"

# Demo accounts (development / optional seed only)
DEMO_PASSWORD="Demo@SchoolMart2026"

# Redis (Phase 3+)
REDIS_URL="redis://localhost:6379"

# Payments provider: mock (default) | mpesa
# When mpesa: all MPESA_* below are required or STK initiate fails clearly (no silent mock).
PAYMENTS_PROVIDER="mock"

# M-PESA Daraja STK Push (platform paybill/shortcode — parents pay SchoolMart)
# Callback must be publicly reachable and end with the webhook token, e.g.
# https://api.example.com/api/v1/payments/webhooks/mpesa/<MPESA_WEBHOOK_TOKEN>
# Generate the token with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MPESA_WEBHOOK_TOKEN=""
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_PASSKEY=""
MPESA_SHORTCODE=""
MPESA_CALLBACK_URL=""
MPESA_ENV="sandbox"
