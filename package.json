{
  "name": "schoolmart",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:web": "turbo build --filter=@schoolmart/web",
    "build:api": "turbo build --filter=@schoolmart/api",
    "start:api": "pnpm --filter @schoolmart/db migrate:deploy && pnpm --filter @schoolmart/api start",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "pnpm --filter @schoolmart/db generate",
    "db:migrate": "pnpm --filter @schoolmart/db migrate",
    "db:seed": "pnpm --filter @schoolmart/db seed",
    "smoke:demo-logins": "node scripts/demo-login-smoke.mjs",
    "smoke:e2e-checkout": "node scripts/e2e-checkout-smoke.mjs",
    "db:studio": "pnpm --filter @schoolmart/db studio"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
