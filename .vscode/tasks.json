{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "pnpm:dev",
      "type": "shell",
      "command": "pnpm dev",
      "options": {
        "cwd": "${workspaceFolder}",
        "envFile": "${workspaceFolder}/.env"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "(ready|Local:|SchoolMart API running)"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "pnpm:typecheck",
      "type": "shell",
      "command": "pnpm typecheck",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "pnpm:test",
      "type": "shell",
      "command": "pnpm test",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test"
    }
  ]
}
